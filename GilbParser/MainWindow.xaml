<Window x:Class="GilbParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAB2a"
        Height="780" Width="1200"
        MinHeight="620" MinWidth="980"
        Background="#07101C">
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07101C" Offset="0"/>
                <GradientStop Color="#10203A" Offset="0.45"/>
                <GradientStop Color="#0A162C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-180,-220,0,0" IsHitTestVisible="False" Grid.ColumnSpan="2">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#335B8CFF" Offset="0"/>
                    <GradientStop Color="#0007101C" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-160,-180" IsHitTestVisible="False" Grid.Column="1">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#283EE0C2" Offset="0"/>
                    <GradientStop Color="#0007101C" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="18,18,18,18" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1B2C55" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="" FontSize="11" FontWeight="Bold" Foreground="#7AA2FF"/>
                        </Border>
                        <TextBlock Text="Анализатор сложности" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text=""
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <CheckBox x:Name="LoopNestingCheck"
                          Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Учитывать циклы в CLI"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Открыть .kt" Style="{StaticResource AppButton}" Click="OpenFile_Click"/>
                        <Button Content="Образец" Style="{StaticResource AppButton}" Click="LoadSample_Click"/>
                        <Button Content="Рассчитать метрики" Style="{StaticResource PrimaryButton}" Click="Calculate_Click"/>
                    </WrapPanel>
                    <Border Grid.Column="1" Background="#18263C" CornerRadius="9" Padding="10,7" MaxWidth="420" Margin="12,0,0,0">
                        <TextBlock x:Name="FileLabel"
                                   Text="Файл не выбран (введён код вручную)"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Исходный код" Style="{StaticResource SectionTitle}" Margin="16,14,16,10"/>
                        <Border Grid.Row="1"
                                Background="#0A1422"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,16,16"
                                ClipToBounds="True">
                            <TextBox x:Name="CodeEditor"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="13.5"
                                     TextWrapping="NoWrap"/>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="Transparent"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Результаты" Style="{StaticResource SectionTitle}" Margin="2,2,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="CL · Джилб" Style="{StaticResource MetricLabel}" Foreground="#7AA2FF"/>
                                <TextBlock x:Name="ClText" Text="—" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="абсолютная сложность" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="cl · относительная" Style="{StaticResource MetricLabel}" Foreground="#3EE0C2"/>
                                <TextBlock x:Name="RelText" Text="—" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="CL / число операторов" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="CLI · вложенность" Style="{StaticResource MetricLabel}" Foreground="#F5C15A"/>
                                <TextBlock x:Name="CliText" Text="—" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="максимальный уровень" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Операторы" Style="{StaticResource MetricLabel}" Foreground="#8BA0C0"/>
                                <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="всего в программе" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Найденные операторы"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="13"
                                       Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1"
                                     x:Name="DetailsList"
                                     ToolTip="Найденные операторы ветвления и цикла">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#F0F5FF"
                                                   FontSize="12.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
